/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {

    public boolean findTarget(TreeNode root, int k) {
        return dfs(root, root, k);
    }

    private boolean dfs(TreeNode originalRoot, TreeNode node, int k) {

        if(node==null)
            return false;

        return search(originalRoot, node, k-node.val)
                || dfs(originalRoot,node.left,k)
                || dfs(originalRoot,node.right,k);
    }

    private boolean search(TreeNode curr, TreeNode node, int target){

        if(curr==null)
            return false;

        if(curr.val==target)
            return curr!=node;

        if(target<curr.val)
            return search(curr.left,node,target);

        return search(curr.right,node,target);
    }
}
