class Solution {
    List<String> result = new ArrayList<>();

    public List<String> generateParenthesis(int n) {
        generate("", n, n);
        return result;
    }
    private void generate(String s, int open, int close) {
        if (open == 0 && close == 0) {
            result.add(s);
            return;
        }
        if (open > 0) {
            generate(s + "(", open - 1, close);
        }
        if (close > open) {
            generate(s + ")", open, close - 1);
        }
    }
}
